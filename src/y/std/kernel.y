// std/kernel.y -- the freestanding half of std, for `ycc --kernel`.
//
// A kernel program imports this and nothing else that reaches a kernel: the
// user-space units (fs, net, exec, ...) are refused by the compiler in kernel
// mode (native.y's kernel_std_denied), because every one of them is a Linux
// syscall away from working.  What is here is the machine's own surface --
// COM1, the 8259, the IDT -- plus one definition per interrupt line, so a
// handler declaration can name the line instead of spelling it.
//
// The primitives are `ndef`s into src/y/arch/kernel.s, the same bridge
// std/math.y uses for its float kernels.  `y_` is the reserved prefix, so
// these keep their bare label names however a program refers to them.
//
// Output needs nothing from this file: `print`/`puts` reach `y_os_write`,
// which in a kernel IS the serial port (arch/kernel.s replaces it), so the
// ordinary std formatting works unchanged.

// ── the interrupt lines ─────────────────────────────────────────────────
// One definition per 8259 line, in the order the chips number them.
const IRQ_TIMER = 0;
const IRQ_KEYBOARD = 1;
const IRQ_CASCADE = 2;
const IRQ_COM2 = 3;
const IRQ_COM1 = 4;
const IRQ_LPT2 = 5;
const IRQ_FLOPPY = 6;
const IRQ_LPT1 = 7;
const IRQ_CMOS = 8;
const IRQ_FREE1 = 9;
const IRQ_FREE2 = 10;
const IRQ_FREE3 = 11;
const IRQ_MOUSE = 12;
const IRQ_FPU = 13;
const IRQ_ATA1 = 14;
const IRQ_ATA2 = 15;

// ── the machine primitives (src/y/arch/kernel.s) ────────────────────────
ndef y_serial_init() -> long = "y_serial_init";
ndef y_serial_irq_on() -> long = "y_serial_irq_on";
ndef y_serial_putb(c: long) -> long = "y_serial_putb";
ndef y_serial_getb() -> long = "y_serial_getb";
ndef y_pic_remap() -> long = "y_pic_remap";
ndef y_pic_eoi(irq: long) -> long = "y_pic_eoi";
// Generated by the compiler for every kernel: fills the IDT, installs the
// stub of each `irq N def` (arch_x64.y kernel_irq_text), and loads it.
ndef y_kernel_irq_init() -> long = "y_kernel_irq_init";
ndef y_kernel_sti() -> long = "y_kernel_sti";
ndef y_kernel_cli() -> long = "y_kernel_cli";
ndef y_kernel_halt() -> long = "y_kernel_halt";
ndef y_kernel_idle() -> long = "y_kernel_idle";

// ── the surface a kernel program uses ───────────────────────────────────

// Bring the console and the interrupt controllers up and load the IDT.
// Call it first.  Every vector starts out pointing at a stub that stops the
// machine; the ones a program declared with `irq N def` are installed on top
// of that by the same generated routine.
def init() -> void {
    // Nothing may allocate before phys_init: it is what gives the Y heap its
    // region.  Interrupts are off for the whole bring-up, so an interrupt's
    // own allocation cannot land in the middle of the decision.
    y_kernel_cli();
    phys_init();
    y_serial_init();
    y_pic_remap();
    y_kernel_irq_init();
    y_kernel_sti();
};

// Open COM1's receiver interrupt (IRQ4).  Until this is called the port is
// polled-only and the line stays masked.
def serial_irq_on() -> void {
    y_serial_irq_on();
};

// Acknowledge line `irq` (0..15) on the 8259s.
def eoi(irq: long) -> void {
    y_pic_eoi(irq);
};

def sti() -> void {
    y_kernel_sti();
};

def cli() -> void {
    y_kernel_cli();
};

// Stop the machine (interrupts off, for good).
def halt() -> void {
    y_kernel_halt();
};

// Leave qemu through the isa-debug-exit device; the test harness reads the
// verdict this way.  `code` is 0..255 and qemu exits with (code << 1) | 1.
def kexit(code: long) -> void {
    y_kexit(code);
};

// Wait for interrupts with them enabled -- where a kernel whose work is done
// by `irq` handlers spends its time.  It does not return; the top level ends
// in it.
def idle() -> void {
    y_kernel_idle();
};

// One byte out (waiting for the transmitter), one byte in (waiting for the
// receiver).  `print`/`puts` are the bulk output path.
def putc(c: long) -> void {
    y_serial_putb(c);
};

def getc() -> long {
    y_serial_getb()
};

// ── raw memory ──────────────────────────────────────────────────────────
// Y has no address-to-pointer conversion -- a `*T` comes only from `&x` or
// `arr.ptr` -- but a pointer to a GLOBAL can be MOVED by pointer arithmetic,
// and a global's address is known.  So one 8-byte anchor is the whole of the
// kernel's raw memory access: every read and write below is a pointer
// arithmetic step away from it.  (This is the hack the language needs until
// an integer-to-pointer cast exists; it is also why the kernel can touch page
// tables, the Multiboot structure and device memory with no assembly.)
let mem_word: long = 0;

// The kernel's own mapping is ONE 2 MB page at 1 MB (arch_x64.y's trampoline):
// the image and nothing else in the low half, so that 0x400000 -- where a
// Linux executable is linked -- stays free for user space.  Everything else
// in RAM is reached through the direct map the trampoline also builds, all of
// RAM in 2 MB pages at 0xFFFF888000000000.  As a signed 64-bit long that base
// is negative, and Y's pointer arithmetic carries it exactly.
//
// CONVENTION: peek*/poke* take a PHYSICAL address and add this; the Y heap's
// own pointers are direct-map VIRTUAL addresses (phys_init sets them up that
// way).  Mixing the two is the one way to get this wrong.
const DIRECT_BASE = -131391639519232;

// The aligned 8-byte word at PHYSICAL `addr`, which is the one operation
// pointer arithmetic gives us: `*(p + k)` addresses p + 8k, so `addr` has to
// be 8-byte aligned.  Everything else is built on top of it, and the mask is
// spelled out rather than written as 2^52-1 because a 64-bit literal is what
// the encoder can emit (an ALU immediate is 32 bits).
def peek_word(addr: long) -> long {
    let p: *long = &mem_word;
    *(p + (addr + DIRECT_BASE - ptr_addr(p)) / 8)
};

def poke_word(addr: long, v: long) -> void {
    let p: *long = &mem_word;
    *(p + (addr + DIRECT_BASE - ptr_addr(p)) / 8) = v;
};

// The 32-bit field at `addr`, zero-extended.  The Multiboot memory map's
// u64 fields sit at offset 4 of a 24-byte entry -- 4-aligned, not 8 -- so
// this is the primitive, and the 64-bit read below is two of them.
def peek32(addr: long) -> long {
    let sh = (addr % 8) * 8;
    ((peek_word(addr - addr % 8) >> sh) << 32) >>> 32
};

def poke32(addr: long, v: long) -> void {
    let base = addr - addr % 8;
    let sh = (addr % 8) * 8;
    let w = peek_word(base);
    let mask = 4294967295 << sh;
    poke_word(base, (w & ~mask) | (((v << 32) >>> 32) << sh));
};

// ── the same reads and writes at a VIRTUAL address ──────────────────────
// peek*/poke* above take physical addresses because that is what page tables,
// hardware structures and another process's pages are addressed by.  These
// take an address in the CURRENT address space: the kernel's own image (which
// is identity-mapped in the first 2 MB) and, while running on a task's CR3,
// that task's memory.  A syscall that copies to or from a user buffer uses
// these, after checking the range is the user's.
def peek_va64(addr: long) -> long {
    let p: *long = &mem_word;
    *(p + (addr - ptr_addr(p)) / 8)
};

def poke_va64(addr: long, v: long) -> void {
    let p: *long = &mem_word;
    *(p + (addr - ptr_addr(p)) / 8) = v;
};

// The 64-bit word at physical `addr`, any 4-byte alignment.
def peek64(addr: long) -> long {
    peek32(addr) | (peek32(addr + 4) << 32)
};

def poke64(addr: long, v: long) -> void {
    poke32(addr, v);
    poke32(addr + 4, v >> 32);
};

// A byte, any alignment.
def peek8(addr: long) -> long {
    let sh = (addr % 8) * 8;
    (peek_word(addr - addr % 8) >> sh) & 255
};

def poke8(addr: long, v: long) -> void {
    let base = addr - addr % 8;
    let sh = (addr % 8) * 8;
    let w = peek_word(base);
    let mask = 255 << sh;
    poke_word(base, (w & ~mask) | ((v & 255) << sh));
};

// ── physical memory ─────────────────────────────────────────────────────
ndef y_mb_info_get() -> long = "y_mb_info_get";
ndef y_kernel_end_get() -> long = "y_kernel_end_get";
ndef y_heap_region_set(start: long, limit: long) -> long = "y_heap_region_set";
ndef y_heap_start_get() -> long = "y_heap_start_get";
ndef y_heap_bias_get() -> long = "y_heap_bias_get";
ndef y_heap_limit_get() -> long = "y_heap_limit_get";
ndef y_kexit(code: long) -> long = "y_kexit";

// The Multiboot info structure (`info`), as the loader left it.  Offsets are
// the Multiboot 1 spec's: flags, mem_lower, mem_upper, boot_device, cmdline,
// mods_count, mods_addr, syms[4], mmap_length, mmap_addr.
const MB_FLAG_MEM = 1;
const MB_FLAG_MMAP = 64;

def mb_present() -> bool {
    y_mb_info_get() != 0
};

def mb_flags() -> long {
    if (mb_present()) { peek32(y_mb_info_get()) } else { 0 }
};

// RAM in KB below and above 1 MB (the spec's mem_lower/mem_upper).
def mb_mem_lower_kb() -> long {
    if (mb_present()) { peek32(y_mb_info_get() + 4) } else { 0 }
};

def mb_mem_upper_kb() -> long {
    if (mb_present()) { peek32(y_mb_info_get() + 8) } else { 0 }
};

// The kernel's command line, as the loader left it.  It is a NUL-terminated
// string at a physical address, and (QEMU, at least) it lives in the pages
// just past the loaded image -- which is also where a page allocator wants to
// start.  phys_init reads it so the first page it hands out cannot be the
// one holding the command line.
def mb_cmdline_addr() -> long {
    if (mb_present()) { peek32(y_mb_info_get() + 16) } else { 0 }
};

def str_len_at(addr: long) -> long {
    let n = 0;
    while (peek8(addr + n) != 0) { n = n + 1; };
    n
};

def mb_mmap_addr() -> long {
    if (mb_present()) { peek32(y_mb_info_get() + 48) } else { 0 }
};

def mb_mmap_len() -> long {
    if (mb_present()) { peek32(y_mb_info_get() + 44) } else { 0 }
};

// The length of the largest available RAM region the loader reported, in
// bytes, and the address where it starts.  A Multiboot mmap entry is
// {size: u32, base: u64, length: u64, type: u32} with `size` NOT counting
// itself; type 1 is available RAM.  Reading the whole map rather than
// mem_upper is what makes a kernel work on a machine whose RAM is not one
// contiguous block.
type MemRegion = { base: long, len: long };

def mb_region_count() -> long {
    let n = 0;
    if ((mb_flags() & MB_FLAG_MMAP) != 0) {
        let at = mb_mmap_addr();
        let end = at + mb_mmap_len();
        while (at < end) {
            if (peek32(at + 20) == 1) { n = n + 1; };
            at = at + peek32(at) + 4;
        };
    };
    n
};

def mb_region(i: long) -> MemRegion {
    let out: MemRegion = { base: 0, len: 0 };
    if ((mb_flags() & MB_FLAG_MMAP) != 0) {
        let at = mb_mmap_addr();
        let end = at + mb_mmap_len();
        let k = 0;
        while (at < end) {
            if (peek32(at + 20) == 1) {
                if (k == i) {
                    out = { base: peek64(at + 4), len: peek64(at + 12) };
                };
                k = k + 1;
            };
            at = at + peek32(at) + 4;
        };
    };
    out
};

// The Multiboot modules (`-initrd` is one): what the loader put in RAM that a
// page allocator must not hand out.  QEMU's layout is image, then command
// line, then the module, so the highest end wins.
def mb_mod_count() -> long {
    if (mb_present()) { peek32(y_mb_info_get() + 20) } else { 0 }
};

def mb_mod_addr() -> long {
    if (mb_present()) { peek32(y_mb_info_get() + 24) } else { 0 }
};

def mb_mod_end(i: long) -> long {
    if (mb_present()) { peek32(mb_mod_addr() + i * 16 + 4) } else { 0 }
};

// The first byte no loader structure occupies: the image's end, raised past
// the command line and every module.  Allocation-free on purpose -- phys_init
// runs on the bootstrap heap.
def reserved_end() -> long {
    let end = y_kernel_end_get();
    let cl = mb_cmdline_addr();
    if (cl != 0) {
        let cle = cl + str_len_at(cl) + 1;
        if (cle > end) { end = cle; };
    };
    let i = 0;
    let n = mb_mod_count();
    while (i < n) {
        let e = mb_mod_end(i);
        if (e > end) { end = e; };
        i = i + 1;
    };
    end
};

// A bump allocator over that region: the honest first version (no free yet).
// Pages come back 4 KB aligned, which is what page tables, stacks and the
// Y heap all need.
let phys_next = 0;
let phys_limit = 0;

// The Y heap's region, chosen from the Multiboot numbers the first time
// anything allocates -- which may be during ANOTHER module's global
// initializer, before the hoisted global-init code has run.
//
// *** HARD RULE for this function and everything it calls: no Y global and no
// `const`.  A const's cell is a global like any other, and reading one at this
// point reads zero -- which is how the first version of this put the heap at
// the wrong address (HEAP_BYTES read as 0 made `top <= start` fall into the
// floor branch) and then faulted storing into it.  Literals, asm accessors
// (y_*_get) and functions that obey the same rule only. ***  arch/kernel.s's
// y_alloc_map calls this, and the double check makes it safe against an
// interrupt that allocates while it runs.
//
// The region is the 8 MB below the top of RAM: at the top so that nothing the
// loader left in the low pages (the image, its command line, the initrd) can
// be inside it, and fixed so that the page allocator, which grows up from the
// image, has a boundary it can be told about without sharing an allocator.
const HEAP_BYTES = 8388608;

def y_heap_init() -> void {
    if (y_heap_limit_get() == 0) {
        let top = 1048576 + mb_mem_upper_kb() * 1024;
        if (mb_mem_upper_kb() == 0) { top = y_kernel_end_get() + 67108864; };
        top = top - top % 4096;
        let start = top - 8388608;
        let floor = y_kernel_end_get() + 1048576;
        if (floor % 4096 != 0) { floor = floor + 4096 - floor % 4096; };
        if (start < floor) { start = floor; };
        if (top <= start) { start = floor; };
        if (y_heap_limit_get() == 0) {
            // Physical addresses: arch/kernel.s adds the direct-map base, so
            // this path has no dependency on a global cell being initialized.
            y_heap_region_set(start, top);
        };
    };
};

// The kernel's memory, decided once.  Two consumers and one boundary: the
// Y heap owns the last 8 MB of RAM, and physical pages -- address
// spaces, stacks, a process's memory, every message buffer -- are handed out
// from the image's end up to the heap's first byte.  `start` clears the
// loader's command line and every Multiboot module: QEMU puts the initrd in
// RAM too, and an allocator that starts at the image's end hands the initrd
// out as if it were free.
def phys_init() -> void {
    if (phys_next == 0) {
        y_heap_init();
        let start = reserved_end();
        if (start % 4096 != 0) { start = start + 4096 - start % 4096; };
        let limit = y_heap_start_get();
        if (limit < start) { limit = start; };
        phys_next = start;
        phys_limit = limit;
    };
};

// How much physical RAM the allocator can still hand out, in bytes.
def phys_free_bytes() -> long {
    phys_init();
    phys_limit - phys_next
};

// How much RAM the Y heap was given, in bytes (0 before the first allocation).
def heap_bytes() -> long {
    y_heap_init();
    y_heap_limit_get() - y_heap_bias_get()
};

// Where the heap and the page allocator are, for a test to print.
def heap_start_phys() -> long { y_heap_init(); y_heap_start_get() };
def phys_start() -> long { phys_init(); phys_next };

def page_alloc() -> long {
    phys_init();
    if (phys_next + 4096 > phys_limit) { return 0; };
    let p = phys_next;
    phys_next = phys_next + 4096;
    p
};

// `n` bytes, page aligned: what a future `y_alloc_map` would ask for.
def pages_alloc(n: long) -> long {
    phys_init();
    let want = n;
    if (want % 4096 != 0) { want = want + 4096 - want % 4096; };
    if (phys_next + want > phys_limit) { return 0; };
    let p = phys_next;
    phys_next = phys_next + want;
    p
};

// ── virtual memory ──────────────────────────────────────────────────────
// Four levels, 4 KB pages, 48-bit virtual addresses: PML4 -> PDPT -> PD ->
// PT.  Every table is a physical page, identity-mapped (the trampoline maps
// the first 1 GB), so a walk is pointer arithmetic and nothing else -- the
// whole of a page-table write is peek64/poke64, which is why this needs no
// assembly at all.
const PTE_P = 1;
const PTE_W = 2;
const PTE_U = 4;
const PTE_PWT = 8;
const PTE_PCD = 16;
const PTE_A = 32;
const PTE_D = 64;
const PTE_PS = 128;
// The physical-address field of a page-table entry: bits 12..51.  NOT
// 2^52-1, which keeps the low twelve FLAG bits in the address -- that
// mistake walks to entry|flags, reads the next word at a misaligned offset,
// and the walk still returns a plausible-looking number, so it fails as a
// page fault far from here rather than as a wrong mask.
const PHYS_MASK = 4503599627366400;
// A large-page entry keeps its offset bits inside the entry: a 2 MB page's
// low 21 bits are flags, a 1 GB page's low 30.  A walker that reads one as a
// table address walks into the mapped memory itself -- which is what the
// kernel's own identity map is made of (the trampoline uses 2 MB pages), so
// this is not an exotic case, it is the common one.
const PHYS_MASK_2M = 4503599625273344;
const PHYS_MASK_1G = 4503598553628672;

ndef y_cr3_get() -> long = "y_cr3_get";
ndef y_cr3_set(dir: long) -> long = "y_cr3_set";
ndef y_cr2_get() -> long = "y_cr2_get";

def pml4_index(v: long) -> long { (v >> 39) & 511 };
def pdpt_index(v: long) -> long { (v >> 30) & 511 };
def pd_index(v: long) -> long { (v >> 21) & 511 };
def pt_index(v: long) -> long { (v >> 12) & 511 };

// One level of the walk: the table `entry` names, or 0.  `create` makes a
// missing one (and answers 0 when physical memory runs out).
def vm_next_table(entry: long, create: bool) -> long {
    if ((entry & PTE_P) != 0) { entry & PHYS_MASK } else if (!create) { 0 } else { page_alloc() }
};

// The page-table slot that maps `v` under `dir`, or 0.  A 4 KB mapping
// cannot be made inside a large page, so an entry with PS set at either
// level refuses (0) rather than being read as a table address; splitting a
// large page is a page-table operation this runtime does not have yet.
def vm_slot(dir: long, v: long, create: bool) -> long {
    let e4 = peek64(dir + pml4_index(v) * 8);
    let l4 = vm_next_table(e4, create);
    if (l4 == 0) { return 0; };
    if ((e4 & PTE_PS) != 0) { return 0; };
    if (create) { poke64(dir + pml4_index(v) * 8, l4 | PTE_P | PTE_W); };
    let e3 = peek64(l4 + pdpt_index(v) * 8);
    let l3 = vm_next_table(e3, create);
    if (l3 == 0) { return 0; };
    if ((e3 & PTE_PS) != 0) { return 0; };
    if (create) { poke64(l4 + pdpt_index(v) * 8, l3 | PTE_P | PTE_W); };
    let e2 = peek64(l3 + pd_index(v) * 8);
    let l2 = vm_next_table(e2, create);
    if (l2 == 0) { return 0; };
    if ((e2 & PTE_PS) != 0) { return 0; };
    if (create) { poke64(l3 + pd_index(v) * 8, l2 | PTE_P | PTE_W); };
    l2 + pt_index(v) * 8
};

// Map one 4 KB page: `v` (the virtual address) sees `p` (the physical one).
def vm_map(dir: long, v: long, p: long, flags: long) -> bool {
    let slot = vm_slot(dir, v, true);
    if (slot == 0) { return false; };
    poke64(slot, (p & PHYS_MASK) | flags | PTE_P);
    vm_flush(v);
    true
};

// Map `pages` 4 KB pages, virtual and physical both stepping by 4 KB.
def vm_map_range(dir: long, v: long, p: long, pages: long, flags: long) -> long {
    let i = 0;
    let n = 0;
    while (i < pages) {
        if (vm_map(dir, v + i * 4096, p + i * 4096, flags)) { n = n + 1; };
        i = i + 1;
    };
    n
};

def vm_unmap(dir: long, v: long) -> void {
    let slot = vm_slot(dir, v, false);
    if (slot != 0) { poke64(slot, 0); vm_flush(v); };
};

// The physical address `v` maps to under `dir`, or 0 when it does not map.
// Its own walk rather than vm_slot's, because this one has to UNDERSTAND a
// large page (the kernel's 1 GB is 512 of them) and vm_slot cannot.
def vm_translate(dir: long, v: long) -> long {
    let e4 = peek64(dir + pml4_index(v) * 8);
    if ((e4 & PTE_P) == 0) { return 0; };
    let e3 = peek64((e4 & PHYS_MASK) + pdpt_index(v) * 8);
    if ((e3 & PTE_P) == 0) { return 0; };
    if ((e3 & PTE_PS) != 0) { return (e3 & PHYS_MASK_1G) + v % 1073741824; };
    let e2 = peek64((e3 & PHYS_MASK) + pd_index(v) * 8);
    if ((e2 & PTE_P) == 0) { return 0; };
    if ((e2 & PTE_PS) != 0) { return (e2 & PHYS_MASK_2M) + v % 2097152; };
    let e1 = peek64((e2 & PHYS_MASK) + pt_index(v) * 8);
    if ((e1 & PTE_P) == 0) { return 0; };
    (e1 & PHYS_MASK) + v % 4096
};

// Drop `v` from the TLB.  `invlpg` is the only instruction here and it is
// raw bytes for the same reason the control-register reads are: one operand
// kind the encoder does not have.  0F 01 /7.
def vm_flush(v: long) -> void {
    vm_flush_raw(v);
};

ndef vm_flush_raw(v: long) -> long = "y_invlpg";

def vm_switch(dir: long) -> void {
    y_cr3_set(dir);
};

def vm_current() -> long {
    y_cr3_get()
};

// A fresh address space.  The kernel's own 1 GB -- PML4[0] -> PDPT[0] -> the
// 512 2 MB pages the trampoline built -- is copied entry by entry, so the
// kernel's code, its stacks and the serial port stay reachable from every
// address space; everything above it starts unmapped, which is what makes
// two address spaces two address spaces.
//
// The first version shared PML4[0] itself, and that shares the whole subtree
// under it: a second address space saw the first one's user pages (the
// t006 fixture's last two lines are the difference).  Copying the top PDPT
// entry instead of the PML4 entry is the cheap fix; the real one is a
// higher-half kernel, where user space owns PML4[0] and the kernel owns
// entries 256..511 and nothing has to be copied at all.
def vm_new_dir() -> long {
    let dir = page_alloc();
    if (dir == 0) { return 0; };
    let pdpt = page_alloc();
    if (pdpt == 0) { return 0; };
    let pd = page_alloc();
    if (pd == 0) { return 0; };
    // The kernel's own mapping is its boot PD[0] (the first 2 MB), copied in:
    // its code, its stacks, the IDT and the trap stubs are reachable from
    // every address space, and nothing else in the low half is.  That is what
    // leaves 0x400000 -- where a Linux executable is linked -- to the program.
    let cur = vm_current();
    let pdpt_low = peek64(cur) & PHYS_MASK;
    let pd_low = peek64(pdpt_low) & PHYS_MASK;
    poke64(pd, peek64(pd_low));
    poke64(pdpt, pd | PTE_P | PTE_W);
    poke64(dir, pdpt | PTE_P | PTE_W);
    // PML4[273]: the direct map, shared.  The kernel reaches every physical
    // page through it while running on this address space.
    poke64(dir + 273 * 8, peek64(cur + 273 * 8));
    dir
};

// ── the CPU's exceptions ────────────────────────────────────────────────
// Called by the stubs the compiler generates (arch_x64.y's kernel_irq_text)
// with the vector number and the CPU's error code.  A program may replace it
// by defining its own `y_kernel_trap(vec, err)`: `y_` is the reserved prefix
// the compiler emits under its bare name, and the generated stubs call that
// name.  (Not while this file is linked, which also defines it -- the
// override is a bare kernel program's, or a fork of this file's.)
def y_kernel_trap(vec: long, err: long) -> void {
    // Built with tostring, not print: `print` ends its value with a newline,
    // and the report is one line.  No allocation beyond the message, so a
    // trap that fires while the allocator is the problem still reports.
    let msg = "\ntrap vector=" + tostring(vec) + " err=" + tostring(err);
    if (vec == 14) { msg = msg + " cr2=" + tostring(y_cr2_get()); };
    if (vec == 13) { msg = msg + " (general protection)"; };
    puts(msg + "\n");
    y_kernel_halt();
};
