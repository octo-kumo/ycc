// arch_x64.y — Linux x86_64 code emitters for the native backend (ycc).
//
// NOTE: restored mechanically from yboot C emission after an accidental
// overwrite; all original comments are lost. Known-good state at restore:
// y_arr_clone / y_rec_clone take the arg in %rdi; y_rec_clone copies field
// values from (%rbx,%r8,8) and pops r14 (stage-4 segfault source — fixed here).

def arch_id() -> str {
    "x86_64-linux"
};

def arch_word() -> long {
    8
};

// syscall number table. NOTE: nested ifs, not `||` (C toolchain).
def arch_sysno(name: str) -> long {
    if (name == "read") { 0 }
    else if (name == "write") { 1 }
    else if (name == "close") { 3 }
    else if (name == "openat") { 257 }
    else if (name == "exit") { 60 }
    else { -1 }
};

def arch_fn_label(uid: long, name: str) -> str {
    "yfn_" + tostring(uid) + "_" + name
};

def arch_loc_label(fuid: long, n: long) -> str {
    "yL_" + tostring(fuid) + "_" + tostring(n)
};

def arch_str_label(i: long) -> str {
    "ystr_" + tostring(i)
};

def arch_header() -> str {
    ".text\n.globl _start\n"
};

def arch_rodata() -> str {
    ".section .rodata\n"
};

def arch_text() -> str {
    ".text\n"
};

def arch_frame(slots: long) -> long {
    // slots * 8, rounded up to a multiple of 16 (call alignment)
    let bytes = slots * 8;
    if (bytes % 16 == 0) { bytes } else { bytes + (16 - bytes % 16) }
};

def arch_exit() -> str {
    "    mov \$60, %rax\n    xor %edi, %edi\n    syscall\n"
};

