        "y_str_to_bytes:",
        "    push %rbp",
        "    mov %rsp, %rbp",
        "    push %rbx",
        "    push %r13",
        "    push %r14",
        "    mov 16(%rbp), %rbx",
        "    mov (%rbx), %r13",
        "    mov %r13, %rdi",
        "    cmp $8, %rdi",
        "    jge ystb_sz",
        "    mov $8, %rdi",
        "ystb_sz:",
        "    call y_alloc",
        "    mov %rax, %r14",
        "    push %r14",
        "    mov $24, %rdi",
        "    call y_alloc",
        "    pop %r14",
        "    mov %r13, (%rax)",
        "    mov %r13, 8(%rax)",
        "    mov %r14, 16(%rax)",
        "    push %rax",
        "    xor %r8d, %r8d",
        "ystb_loop:",
        "    cmp %r13, %r8",
        "    jge ystb_done",
        "    movzbq 8(%rbx,%r8,1), %rdx",
        "    movb %dl, (%r14,%r8,1)",
        "    inc %r8",
        "    jmp ystb_loop",
        "ystb_done:",
        "    pop %rax",
        "    pop %r14",
        "    pop %r13",
        "    pop %rbx",
        "    pop %rbp",
        "    ret",
        // y_bytes_to_str(b) -> str: the inverse. The result is a string
