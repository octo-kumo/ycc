        "y_bytes_to_str:",
        "    push %rbp",
        "    mov %rsp, %rbp",
        "    push %rbx",
        "    push %r13",
        "    push %r14",
        "    mov 16(%rbp), %rbx",
        "    mov (%rbx), %r13",
        "    mov 16(%rbx), %rbx",
        "    mov %r13, %rdi",
        "    add $16, %rdi",
        "    call y_alloc",
        "    mov %rax, %r14",
        "    mov %r13, (%r14)",
        "    xor %r8d, %r8d",
        "ybts_loop:",
        "    cmp %r13, %r8",
        "    jge ybts_done",
        "    movzbq (%rbx,%r8,1), %rdx",
        "    movb %dl, 8(%r14,%r8,1)",
        "    inc %r8",
        "    jmp ybts_loop",
        "ybts_done:",
        "    mov %r14, %rsi",
        "    add $8, %rsi",
        "    add %r13, %rsi",
        "    movb $0, (%rsi)",
        "    mov %r14, %rax",
        "    pop %r14",
        "    pop %r13",
        "    pop %rbx",
        "    pop %rbp",
