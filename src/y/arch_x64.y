        "    mov (%rbx), %rdx",
        "    lea 8(%r14), %rdi",
        "    add %rdx, %rdi",
        "    mov (%r13), %rcx",
        "    test %rcx, %rcx",
        "    jz ysa_skip",
        "    call ysc_copy",
        "ysa_skip:",
        "    mov %r12, (%r14)",
        "    mov %r12, %rbx",
        "    movb $0, 8(%r14,%rbx,1)",
        "    mov %r14, %rax",
        "    pop %r12",
        "    pop %r14",
        "    pop %r13",
        "    pop %rbx",
        "    pop %rbp",
        "    ret",
        "ysc_copy:",
        "    mov %rcx, %rax",
        "    add $7, %rax",
        "    shr $3, %rax",
        "    xor %r8d, %r8d",
        "yscc_loop:",
        "    cmp %rax, %r8",
        "    jge yscc_done",
        "    mov (%rsi,%r8,8), %rdx",
        "    mov %rdx, (%rdi,%r8,8)",
        "    inc %r8",
        "    jmp yscc_loop",
        "yscc_done:",
        "    ret",
        "y_str_join:",
        "    push %rbp",
        "    mov %rsp, %rbp",
        "    push %rbx",
        "    push %r12",
        "    push %r13",
        "    push %r14",
        "    push %r15",
        "    mov 24(%rbp), %rbx",
        "    mov 16(%rbp), %r13",
