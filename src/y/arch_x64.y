        "    push %rcx",
        "    push %r13",
        "    push %r14",
        "    push %rbx",
        "    call ysc_copy",
        "    pop %rbx",
        "    pop %r14",
        "    pop %r13",
        "    pop %rcx",
        "    pop %rsi",
        "    pop %rdi",
        "    movb $0, 8(%rdi,%r13,1)",
        "    mov %rdi, %rax",
        "    sub $8, %rax",
        "    pop %r14",
        "    pop %r13",
        "    pop %rbx",
        "    pop %rbp",
        "    ret",
        // y_str_to_bytes(s) -> [byte]: copy the string's bytes into a
        // packed array header {len, cap, data...}. One byte per element.
        "y_str_to_bytes:",
        "    push %rbp",
        "    mov %rsp, %rbp",
        "    push %rbx",
        "    push %r13",
        "    push %r14",
        "    mov 16(%rbp), %rbx",
        "    mov (%rbx), %r13",
        "    mov %r13, %rdi",
        "    cmp $8, %rdi",
        "    jge ystb_sz",
        "    mov $8, %rdi",
        "ystb_sz:",
        "    call y_alloc",
        "    mov %rax, %r14",
        "    push %r14",
        "    mov $24, %rdi",
        "    call y_alloc",
        "    pop %r14",
        "    mov %r13, (%rax)",
        "    mov %r13, 8(%rax)",
        "    mov %r14, 16(%rax)",
        "    push %rax",
        "    xor %r8d, %r8d",
        "ystb_loop:",
        "    cmp %r13, %r8",
        "    jge ystb_done",
        "    movzbq 8(%rbx,%r8,1), %rdx",
        "    movb %dl, (%r14,%r8,1)",
        "    inc %r8",
        "    jmp ystb_loop",
        "ystb_done:",
        "    pop %rax",
        "    pop %r14",
        "    pop %r13",
        "    pop %rbx",
        "    pop %rbp",
        "    ret",
        // y_bytes_to_str(b) -> str: the inverse. The result is a string
        // header {len, data..., NUL}.
        "y_bytes_to_str:",
        "    push %rbp",
        "    mov %rsp, %rbp",
        "    push %rbx",
        "    push %r13",
        "    push %r14",
        "    mov 16(%rbp), %rbx",
        "    mov (%rbx), %r13",
        "    mov 16(%rbx), %rbx",
        "    mov %r13, %rdi",
        "    add $16, %rdi",
        "    call y_alloc",
        "    mov %rax, %r14",
        "    mov %r13, (%r14)",
        "    xor %r8d, %r8d",
        "ybts_loop:",
        "    cmp %r13, %r8",
        "    jge ybts_done",
        "    movzbq (%rbx,%r8,1), %rdx",
        "    movb %dl, 8(%r14,%r8,1)",
        "    inc %r8",
        "    jmp ybts_loop",
        "ybts_done:",
        "    mov %r14, %rsi",
        "    add $8, %rsi",
        "    add %r13, %rsi",
        "    movb $0, (%rsi)",
        "    mov %r14, %rax",
        "    pop %r14",
        "    pop %r13",
        "    pop %rbx",
        "    pop %rbp",
        "    ret",
    ], "\n") + "\n"
};

// The thread runtime (CHOICES_MADE.md 33), linked only when a program's
// code calls into it (native.y uses_threads): every compile shakes the
// prelude text it is given, line by line, whatever it keeps.
def arch_prelude_threads() -> str {
    join([
        // The first spawn moves the main thread's heap state (cur, end, used)
        // into a block of its own, points %fs at it and empties the global
        // block: from then on y_alloc_slow sends every thread to its own block.
        // A thread's block is [cur, end, used, self, ...]: %fs:24 is its address.
        "y_threads_on:",
        "    lea y_heap(%rip), %rcx",
        "    mov 24(%rcx), %rdx",
        "    test %rdx, %rdx",
        "    jne y_threads_on_done",
        "    mov $48, %rdi",
        "    call y_alloc",
        "    lea y_heap(%rip), %rcx",
        "    mov (%rcx), %rdx",
        "    mov %rdx, 0(%rax)",
        "    mov 8(%rcx), %rdx",
        "    mov %rdx, 8(%rax)",
        "    mov 16(%rcx), %rdx",
        "    mov %rdx, 16(%rax)",
        "    mov %rax, 24(%rax)",
        "    xor %edx, %edx",
        "    mov %rdx, (%rcx)",
        "    mov %rdx, 8(%rcx)",
        "    mov $1, %rdx",
        "    mov %rdx, 24(%rcx)",
        "    mov %rax, %rsi",
        "    mov $158, %rax",
        "    mov $4098, %rdi",
        "    syscall",
        "y_threads_on_done:",
        "    ret",
        // spawn: %rax the block's closure -> %rax its handle, a closure
        // [y_join_code, tcb]. The thread control block is its heap block
        // [cur, end, used, self, stack, spare] then [tid, value, closure];
        // the thread runs on an 8 MiB stack of its own (the mapping at
        // `stack`, a guard page below it), with %fs at the block. Its
        // heap starts in the spawning thread's first spare chunk tail, if
        // it has one: `spare` lists the tails its joins took back, each
        // tail's first two words [end, next].
        "y_spawn:",
        "    push %rbp",
        "    mov %rsp, %rbp",
        "    push %rbx",
        "    push %r12",
        "    mov %rax, %rbx",
        "    call y_threads_on",
        "    mov $72, %rdi",
        "    call y_alloc",
        "    mov %rax, %r12",
        "    mov %r12, 24(%r12)",
        "    mov %rbx, 64(%r12)",
        "    mov %fs:24, %rcx",
        "    mov 40(%rcx), %rax",
        "    test %rax, %rax",
        "    je y_spawn_stack",
        "    mov 8(%rax), %rdx",
        "    mov %rdx, 40(%rcx)",
        "    mov 0(%rax), %rdx",
        "    xor %ecx, %ecx",
        "    mov %rcx, 0(%rax)",
        "    mov %rcx, 8(%rax)",
        "    mov %rax, 0(%r12)",
        "    mov %rdx, 8(%r12)",
        "y_spawn_stack:",
        "    mov $9, %rax",
        "    xor %edi, %edi",
        "    mov $8392704, %rsi",
        "    mov $3, %rdx",
        "    mov $131106, %r10",
        "    mov $-1, %r8",
        "    xor %r9d, %r9d",
        "    syscall",
        "    test %rax, %rax",
        "    js y_alloc_fail",
        "    mov %rax, 32(%r12)",
        "    mov %rax, %rdi",
        "    mov $4096, %rsi",
        "    xor %edx, %edx",
        "    mov $10, %rax",
        "    syscall",
        "    mov 32(%r12), %rsi",
        "    add $8392688, %rsi",
        "    mov %r12, 0(%rsi)",
        "    mov $56, %rax",
        "    mov $4001536, %rdi",
        "    lea 48(%r12), %rdx",
        "    lea 48(%r12), %r10",
        "    mov %r12, %r8",
        "    syscall",
        "    test %rax, %rax",
        "    je y_thread_start",
        "    js y_alloc_fail",
        "    mov $16, %rdi",
        "    call y_alloc",
        "    lea y_join_code(%rip), %rcx",
        "    mov %rcx, 0(%rax)",
        "    mov %r12, 8(%rax)",
        "    pop %r12",
        "    pop %rbx",
        "    pop %rbp",
        "    ret",
        // the new thread: its stack's top holds the tcb; it calls the
        // closure, keeps the value, unmaps its stack (nothing after the
        // munmap touches it) and ends (exit, not exit_group: the kernel
        // then clears tid, in the tcb, and wakes a join)
        "y_thread_start:",
        "    mov %rsp, %rax",
        "    mov 0(%rax), %r12",
        "    xor %ebp, %ebp",
        "    mov 64(%r12), %rax",
        "    push %rax",
        "    mov 0(%rax), %rax",
        "    call *%rax",
        "    mov %rax, 56(%r12)",
        "    mov 32(%r12), %rdi",
        "    mov $8392704, %rsi",
        "    mov $11, %rax",
        "    syscall",
        "    mov $60, %rax",
        "    xor %edi, %edi",
        "    syscall",
        // join: the handle called as a closure -> the thread's value, once
        // its tid is 0. The first join takes the unused tail of the
        // thread's chunk (a page or more; xchg takes it once) onto the
        // joining thread's spare list, for its next spawn.
        "y_join_code:",
        "    mov %rsp, %rax",
        "    mov 8(%rax), %rax",
        "    mov 8(%rax), %rcx",
        "    push %rbx",
        "    mov %rcx, %rbx",
        "y_join_wait:",
        "    mov 48(%rbx), %rdx",
        "    test %rdx, %rdx",
        "    je y_join_done",
        "    mov $202, %rax",
        "    lea 48(%rbx), %rdi",
        "    xor %esi, %esi",
        "    xor %r10d, %r10d",
        "    syscall",
        "    jmp y_join_wait",
        "y_join_done:",
        "    xor %eax, %eax",
        "    xchg %rax, 8(%rbx)",
        "    mov 0(%rbx), %rdi",
        "    mov %rax, %rsi",
        "    sub %rdi, %rsi",
        "    cmp $4096, %rsi",
        "    jl y_join_value",
        "    mov %fs:24, %rcx",
        "    mov %rax, 0(%rdi)",
        "    mov 40(%rcx), %rdx",
        "    mov %rdx, 8(%rdi)",
        "    mov %rdi, 40(%rcx)",
        "y_join_value:",
        "    mov 56(%rbx), %rax",
        "    pop %rbx",
        "    ret",
        // a mutex (%rax): its word 0 is 0 when free, 1 when held, 2 when
        // held and a thread may be waiting for it (Drepper, "Futexes Are
        // Tricky", with xchg alone): a waiter marks it 2 before it sleeps,
        // and only an unlock that finds 2 makes a syscall (the wake)
        "y_mutex_lock:",
        "    push %rbx",
        "    mov %rax, %rbx",
        "    mov $1, %rcx",
        "    xchg %rcx, 0(%rbx)",
        "    test %rcx, %rcx",
        "    je y_mutex_got",
        "y_mutex_wait:",
        "    mov $2, %rcx",
        "    xchg %rcx, 0(%rbx)",
        "    test %rcx, %rcx",
        "    je y_mutex_got",
        "    mov $202, %rax",
        "    mov %rbx, %rdi",
        "    mov $128, %rsi",
        "    mov $2, %rdx",
        "    xor %r10d, %r10d",
        "    syscall",
        "    jmp y_mutex_wait",
        "y_mutex_got:",
        "    pop %rbx",
        "    ret",
        "y_mutex_unlock:",
        "    xor %ecx, %ecx",
        "    xchg %rcx, 0(%rax)",
        "    cmp $2, %rcx",
        "    jne y_mutex_free",
        "    mov %rax, %rdi",
        "    mov $202, %rax",
        "    mov $129, %rsi",
        "    mov $1, %rdx",
        "    syscall",
        "y_mutex_free:",
        "    ret",
        // 1 in %rax when the mutex (%rax) was free and is now held. Taking
        // it with xchg 1 may erase a 2 (a waiter's mark), which then goes
        // back -- and if the mutex was released meanwhile, that takes it.
        "y_mutex_trylock:",
        "    mov $1, %rcx",
        "    xchg %rcx, 0(%rax)",
        "    test %rcx, %rcx",
        "    je y_mutex_took",
        "    cmp $2, %rcx",
        "    jne y_mutex_busy",
        "    xchg %rcx, 0(%rax)",
        "    test %rcx, %rcx",
        "    je y_mutex_took",
        "y_mutex_busy:",
        "    xor %eax, %eax",
        "    ret",
        "y_mutex_took:",
        "    mov $1, %rax",
        "    ret",
        // a semaphore (%rax): its count at 0, guarded by the mutex at 8; a
        // wait sleeps on the count while it is 0
        "y_sem_wait:",
        "    push %rbx",
        "    mov %rax, %rbx",
        "y_sem_again:",
        "    lea 8(%rbx), %rax",
        "    call y_mutex_lock",
        "    mov 0(%rbx), %rcx",
        "    test %rcx, %rcx",
        "    je y_sem_sleep",
        "    sub $1, %rcx",
        "    mov %rcx, 0(%rbx)",
        "    lea 8(%rbx), %rax",
        "    call y_mutex_unlock",
        "    pop %rbx",
        "    ret",
        "y_sem_sleep:",
        "    lea 8(%rbx), %rax",
        "    call y_mutex_unlock",
        "    mov $202, %rax",
        "    mov %rbx, %rdi",
        "    mov $128, %rsi",
        "    xor %edx, %edx",
        "    xor %r10d, %r10d",
        "    syscall",
        "    jmp y_sem_again",
        "y_sem_post:",
        "    push %rbx",
        "    mov %rax, %rbx",
        "    lea 8(%rbx), %rax",
        "    call y_mutex_lock",
        "    mov 0(%rbx), %rcx",
        "    add $1, %rcx",
        "    mov %rcx, 0(%rbx)",
        "    lea 8(%rbx), %rax",
        "    call y_mutex_unlock",
        "    mov $202, %rax",
        "    mov %rbx, %rdi",
        "    mov $129, %rsi",
        "    mov $1, %rdx",
        "    syscall",
        "    pop %rbx",
        "    ret",
        // fork: %rax the block's closure; the child runs it and ends (0),
        // the parent gets the pid (or -errno)
        "y_fork:",
        "    push %rbx",
        "    mov %rax, %rbx",
        "    mov $57, %rax",
        "    syscall",
        "    test %rax, %rax",
        "    je y_fork_child",
        "    pop %rbx",
        "    ret",
        "y_fork_child:",
        "    push %rbx",
        "    mov 0(%rbx), %rax",
        "    call *%rax",
        "    mov $231, %rax",
        "    xor %edi, %edi",
        "    syscall",
    ], "\n") + "\n"
};

def arch_consts() -> str {
    // rodata literals emitted once at the end of the file (string headers,
    // error messages)
    join([
        "ystr_minus_h:",
        ".quad 1",
        ".string \"-\"",
        "ystr_dot_h:",
        ".quad 1",
        ".string \".\"",
        "ystr_bigflt_h:",
        ".quad 23",
        ".string \"<float magnitude >2^63>\"",
        "ystr_divzero: .ascii \"runtime error: division by zero\\n\"",
        "ystr_divzero_end:",
        "ystr_oob: .ascii \"runtime error: index out of bounds\\n\"",
        "ystr_oob_end:",
        "ystr_cast: .ascii \"runtime error: a union value cast to a member it does not hold\\n\"",
        "ystr_cast_end:",
        "ystr_oom: .ascii \"runtime error: out of memory\\n\"",
        "ystr_oom_end:",
        "ystr_opt: .ascii \"runtime error: unwrap of none\\n\"",
        "ystr_opt_end:",
    ], "\n") + "\n"
};

