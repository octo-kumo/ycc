        "    add $16, %rdi",
        "    push %rbx",
        "    push %r13",
        "    push %r14",
        "    call y_alloc",
        "    pop %r14",
        "    pop %r13",
        "    pop %rbx",
        "    mov %rax, %rdi",
        "    mov %r13, (%rdi)",
        "    mov %r14, %rcx",
        "    mov %rbx, %rsi",
        "    mov %rdi, %rax",
        "    add $8, %rax",
        "    mov %rax, %rdi",
        "    push %rdi",
        "    push %rsi",
        "    push %rcx",
        "    push %r13",
        "    push %r14",
        "    push %rbx",
        "    call ysc_copy",
        "    pop %rbx",
        "    pop %r14",
        "    pop %r13",
        "    pop %rcx",
        "    pop %rsi",
        "    pop %rdi",
        "    movb $0, 8(%rdi,%r13,1)",
