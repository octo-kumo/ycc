// compiler_docs.y — generate the compiler's reference pages from its schemas.
//
// The AST and Type records are generated at compile time (ast_nodes.y and
// type_nodes.y), the IR forms are generated by ir_forms.y, and the native
// dispatch is generated by dispatch_codegen.y. A reader should not have to
// expand meta blocks by hand, so this small program imports the same schema
// constants and writes Markdown. It is NOT a second source of truth: every
// table below comes from the constants the compiler itself uses.
//
// Usage: compiler_docs OUTDIR
//   writes OUTDIR/ast.md, types.md, ir.md, dispatch.md.

import fs;
import ast_schema from "../../src/y/ast_schema.y";
import type_schema from "../../src/y/type_schema.y";
import ir_schema from "../../src/y/ir_schema.y";
import dispatch_schema from "../../src/y/dispatch_schema.y";

type Shape = { name: str, fields: [str] };
type FieldSpec = { name: str, typ: str };
type FormRow = { name: str, mnemonic: str, operands: [str] };

def header(title: str, source: str) -> str {
    "# " + title + "\n\n" +
    "> Generated by `src/tools/compiler_docs.y` from `" + source + "`.\n" +
    "> Do not edit this file by hand; run `make compiler-docs`.\n\n"
};

def code(s: str) -> str {
    "`" + s + "`"
};

def shape_of(row: str) -> Shape {
    let parts = split(row, " ");
    let name = parts[0];
    let fields: [str] = [];
    for i in 1..len(parts) { fields += parts[i]; };
    { name: name, fields: fields }
};

def field_spec(s: str) -> FieldSpec {
    let at = index_of(s, ":");
    if (at < 0) {
        { name: s, typ: "?" }
    } else {
        { name: s[:at], typ: s[at + 1:] }
    }
};

def ast_note(name: str) -> str {
    if (name == "Leaf") { "A literal or identifier leaf. `k` says which (number, string, byte, big integer, boolean, identifier)." }
    else if (name == "Bare") { "The void value: an empty `else` arm, an omitted loop clause, or `()`." }
    else if (name == "Wrap") { "One child expression. `k` distinguishes address-of (`K.addr`), dereference (`K.deref`) and `return` (`K.ret`)." }
    else if (name == "Un") { "Prefix unary operator: `-`, `!` or `~`." }
    else if (name == "Bin") { "Binary operator expression; `op` keeps the source spelling and the checker decides its meaning." }
    else if (name == "ArrLit") { "Array literal `[a, b, ...]`." }
    else if (name == "ArrRep") { "Fixed-array repeat literal `[v; n]`." }
    else if (name == "Assign") { "Assignment to a simple binding. The renamer replaces `name` with the binding's unique name." }
    else if (name == "Block") { "A statement sequence. Its value is the last statement without a semicolon." }
    else if (name == "Call") { "Call expression, including the desugared forms of `join`, `lock`, `spawn { ... }` and postfix `!`." }
    else if (name == "Decl") { "A top-level or block-level `let`, `const`, `def` or `native` declaration. `typ` is the written annotation, or `K.tnone`." }
    else if (name == "Dot") { "Field or property read `obj.key`; `nline`/`ncol` locate the name." }
    else if (name == "DotAssign") { "Assignment to a record field `obj.key = v`." }
    else if (name == "Err") { "A parse or resolution error carried as a node so the compiler can report several diagnostics." }
    else if (name == "For") { "C-style `for (init; cond; step) body`; an omitted clause is `Bare`." }
    else if (name == "Foreach") { "`foreach (name in iter) body`." }
    else if (name == "ForRange") { "`for name in lo..hi body`." }
    else if (name == "Func") { "A function declaration or anonymous function literal. `defs` holds one default-value node per parameter." }
    else if (name == "IdxAssign") { "Assignment to an index: `arr[idx] = v`." }
    else if (name == "If") { "`if` with an optional else arm; `has_else` distinguishes an absent else from an empty one." }
    else if (name == "IncDec") { "Prefix or postfix `++`/`--`; `pre` says which form." }
    else if (name == "Index") { "Subscript expression `arr[idx]`." }
    else if (name == "RecLit") { "Record literal (`K.rec`) or map literal (`K.map`), sharing one field layout." }
    else if (name == "MatchEnd") { "The end of a generated match chain: the subject, the types already covered, and the value-arm count." }
    else if (name == "Narrow") { "A type test or cast; `k` is `K.rectest` for a union test and `K.narrow` for a narrowing cast." }
    else if (name == "OpAssign") { "Compound assignment `target op= value`." }
    else if (name == "Slice") { "Slice expression `arr[lo:hi]`; an omitted endpoint is `Bare`." }
    else if (name == "SliceAssign") { "Slice assignment `arr[lo:hi] = v`." }
    else if (name == "Store") { "Store through a pointer: `*p = v` (after desugaring)." }
    else if (name == "TypeDef") { "Alias or record-union declaration. The renamer resolves aliases and usually removes these nodes." }
    else if (name == "While") { "`while (cond) body`." }
    else { "AST node shape." }
};

def field_note(name: str) -> str {
    if (name == "v") { "Value text; how to read it depends on `k`." }
    else if (name == "e") { "The operand expression." }
    else if (name == "op") { "Operator spelling as written in the source." }
    else if (name == "l") { "Left operand." }
    else if (name == "r") { "Right operand." }
    else if (name == "elems") { "Array elements, in source order." }
    else if (name == "n") { "Repeat count or fixed length." }
    else if (name == "name") { "Source name; rename.y makes it unique after parsing." }
    else if (name == "stmts") { "Statements in the block." }
    else if (name == "callee") { "The called expression." }
    else if (name == "args") { "Call arguments, in source order." }
    else if (name == "kind") { "Declaration kind: `\"let\"`, `\"const\"`, `\"def\"` or `\"native\"`." }
    else if (name == "typ") { "A type node; `K.tnone` means no annotation was written." }
    else if (name == "nline") { "Line of the declared or referenced name." }
    else if (name == "ncol") { "Column of the declared or referenced name." }
    else if (name == "obj") { "The record, map or module expression on the left of a dot." }
    else if (name == "key") { "Field or entry name." }
    else if (name == "msg") { "Human-readable diagnostic." }
    else if (name == "init") { "Loop initialization clause, or `Bare`." }
    else if (name == "cond") { "Loop or branch condition." }
    else if (name == "step") { "Loop step clause, or `Bare`." }
    else if (name == "body") { "The loop or function body." }
    else if (name == "iter") { "The value a `foreach` walks." }
    else if (name == "lo") { "Range or slice lower bound, or `Bare`." }
    else if (name == "hi") { "Range or slice upper bound, or `Bare`." }
    else if (name == "params") { "Parameter names, parallel to `ptypes`." }
    else if (name == "ptypes") { "Parameter types, parallel to `params`." }
    else if (name == "ret") { "Return type, or `K.tnone` when the parser leaves it to inference." }
    else if (name == "defs") { "One parameter-default node per parameter: a literal value, `Bare` for none, or `K.optarg` for an optional parameter." }
    else if (name == "label") { "Assembly label for a `native` declaration; empty for ordinary defs." }
    else if (name == "ppos") { "Packed source positions of the parameter names: `line * 65536 + col`." }
    else if (name == "arrow") { "True for a `=>` function literal; false for a `def` or block function." }
    else if (name == "arr") { "The array, slice or string being indexed." }
    else if (name == "idx") { "Subscript expression." }
    else if (name == "then") { "The `if` arm." }
    else if (name == "els") { "The else arm; meaningful only when `has_else` is true." }
    else if (name == "has_else") { "Whether an else arm was written (an empty else is distinct from none)." }
    else if (name == "pre") { "True for prefix `++x`/`--x`, false for postfix." }
    else if (name == "tgt") { "Assignment target." }
    else if (name == "keys") { "Record field or map entry names, parallel to `vals`." }
    else if (name == "vals") { "Record field or map entry values, parallel to `keys`." }
    else if (name == "cover") { "Types already covered by earlier match arms." }
    else if (name == "p") { "Pointer expression being stored through." }
    else { "See the node description." }
};

def ast_md() -> str {
    let out = header("AST node shapes", "src/y/ast_schema.y") +
        "`Node` is a generated union of exact records. Every node carries `k` " +
        "(a `tags.y` tag such as `K.bin`), `line` and `col`; the table below " +
        "lists the fields that make each shape.\n\n" +
        "The union and its helper walks are generated by `ast_nodes.y` through " +
        "`shape_codegen.y`; the schema is the source of truth. A node's `k` " +
        "selects its shape, and code casts only after checking `k`.\n\n" +
        "## Shapes\n\n";
    foreach (row in ast_schema.AST_SHAPES) {
        let sh = shape_of(row);
        out += "### `" + sh.name + "`\n\n" + ast_note(sh.name) + "\n\n";
        if (len(sh.fields) == 0) {
            out += "_No shape-specific fields._\n\n";
        } else {
            out += "| field | type | meaning |\n|---|---|---|\n";
            foreach (f in sh.fields) {
                let fsx = field_spec(f);
                out += "| " + code(fsx.name) + " | " + code(fsx.typ) + " | " + field_note(fsx.name) + " |\n";
            };
            out += "\n";
        };
    };
    out
};

def type_note(name: str) -> str {
    if (name == "TPrim") { "A primitive type. Primitive kinds have no fields and are distinguished by `k` (`K.tlong`, `K.tbyte`, `K.tfloat`, `K.tbool`, `K.tstr`, `K.tvoid`, `K.tbigint`, `K.tnone`, `K.tunk`)." }
    else if (name == "TOf") { "A one-child container. `k` says whether it is an array (`K.tarr`), an option (`K.topt`) or another unary type." }
    else if (name == "TFix") { "A fixed array `[T; n]`." }
    else if (name == "TMap") { "A map `{key => value}`." }
    else if (name == "TRec") { "A structural record. Fields are exact and ordered by the schema; tuple fields are named `$0`, `$1`, ..." }
    else if (name == "TFunc") { "A function type: argument types and return type." }
    else if (name == "TName") { "A named alias before rename.y expands it." }
    else if (name == "TList") { "A list of types. `k` says whether it is a union (`K.tunion`) or a parameter list (`K.tparams`)." }
    else if (name == "TPat") { "A type pattern used by match arms." }
    else if (name == "TPtr") { "A pointer to another type." }
    else if (name == "TInt") { "A sized integer (`i8`, `u32`, ...), used behind a pointer or inside a packed record." }
    else if (name == "TPack") { "A packed record or bits record; `bk` is the bit width for a bits record." }
    else if (name == "TRef") { "A recursive alias reference. `to` may point back into the type graph, so walkers decide whether to descend." }
    else if (name == "TInfer") { "The checker's in-progress return-type marker while a def is inferred." }
    else if (name == "TFree") { "An unknown element/payload in `[]` or `none` before context fills it in." }
    else if (name == "TPend") { "A def's return type while its body is being checked." }
    else if (name == "Err") { "Error poison; keeps a failed check from cascading." }
    else { "Type shape." }
};

def type_field_note(name: str) -> str {
    if (name == "of") { "The element, option payload, pointee or unary child type." }
    else if (name == "key") { "Map key type." }
    else if (name == "fields") { "Record or packed fields, in layout order." }
    else if (name == "args") { "Function argument types." }
    else if (name == "ret") { "Function return type." }
    else if (name == "name") { "Alias or reference name." }
    else if (name == "tmp") { "Recursive-alias placeholder used while the type is encoded." }
    else if (name == "to") { "The referenced type; may be recursive." }
    else if (name == "ts") { "The member types of a union or parameter list." }
    else if (name == "names") { "Pattern binding names." }
    else if (name == "w") { "Integer width in bytes." }
    else if (name == "sg") { "True for a signed sized integer." }
    else if (name == "be") { "True for a big-endian sized integer." }
    else if (name == "bk") { "Bit width for a bits record; 0 for a packed record." }
    else if (name == "n") { "Fixed array length." }
    else if (name == "rets") { "Return statements the checker has seen while inferring." }
    else if (name == "free") { "True when the element/payload is still unknown." }
    else if (name == "self") { "True while a self-call is being inferred." }
    else if (name == "used") { "True once a self-call needed the pending type." }
    else { "See the shape description." }
};

def types_md() -> str {
    let out = header("Type shapes", "src/y/type_schema.y") +
        "`Type` is generated from the same schema as `Node`; `type_nodes.y` " +
        "expands `TYPE_SHAPES` through `shape_codegen.y`. Every type carries " +
        "`k`, and the table lists the fields each shape adds.\n\n" +
        "Three helper records are part of the schema's vocabulary:\n\n" +
        "- `Field { name: str, opt: bool, typ: Type }` — one record or packed field.\n" +
        "- `RetNote { typ: Type, line: long, col: long }` — a return site noted during inference.\n" +
        "- `TRef` is the one shape that may form a cycle; `unfold`/`teq` decide when to follow it.\n\n" +
        "## Shapes\n\n";
    foreach (row in type_schema.TYPE_SHAPES) {
        let sh = shape_of(row);
        out += "### `" + sh.name + "`\n\n" + type_note(sh.name) + "\n\n";
        if (len(sh.fields) == 0) {
            out += "_No shape-specific fields._\n\n";
        } else {
            out += "| field | type | meaning |\n|---|---|---|\n";
            foreach (f in sh.fields) {
                let fsx = field_spec(f);
                out += "| " + code(fsx.name) + " | " + code(fsx.typ) + " | " + type_field_note(fsx.name) + " |\n";
            };
            out += "\n";
        };
    };
    out
};

def operand_wire(name: str) -> str {
    let out = "?";
    foreach (op in ir_schema.IR_OPERANDS) {
        if (op.name == name) { out = op.wire; };
    };
    out
};

def operand_note(name: str) -> str {
    if (name == "REG") { "A register number plus its width in bits (two words)." }
    else if (name == "IND") { "An indirect register operand: `*%reg`." }
    else if (name == "IMM") { "An immediate word." }
    else if (name == "LBL") { "An interned label id." }
    else if (name == "DIFF") { "Two interned labels, rendered `$labelA-labelB`." }
    else if (name == "MEM") { "A memory operand: base, index, scale, displacement and label id (five words)." }
    else if (name == "MEM0") { "Like `MEM`, but with an omitted zero displacement in the listing." }
    else if (name == "FS") { "A thread-local offset for `%fs:`." }
    else { "Operand kind." }
};

def form_row(row: str) -> FormRow {
    let parts = split(row, " ");
    let ops: [str] = [];
    for i in 2..len(parts) { ops += parts[i]; };
    { name: parts[0], mnemonic: parts[1], operands: ops }
};

def ir_md() -> str {
    let movid = 0;
    for i in 0..len(ir_schema.IR_FORMS) {
        if (form_row(ir_schema.IR_FORMS[i]).name == "MOV_I_R") { movid = i; };
    };
    let out = header("Machine IR", "src/y/ir_schema.y") +
        "The native backend emits a flat `[long]` instruction stream. Every " +
        "item occupies **eight words** (`IR_W` in `ir.y`): the first word is a " +
        "form id, the next seven are operand fields. The form's `wire` string " +
        "says how many words each operand uses; unused words are zero.\n\n" +
        "Three ids are not forms:\n\n" +
        "- `IR_LABEL = 200`: one word, a label id.\n" +
        "- `IR_LOC = 201`: two words, file and line for `.loc` under `-g`.\n" +
        "- `IR_TEXT = 202`: one word, an index into the body's raw-text table.\n\n" +
        "Form ids are the positions in `IR_FORMS`; `ir_forms.y` generates " +
        "`F_<NAME>` and `O_<NAME>` constants and the `IrForm` table. " +
        "`ir.y`'s `ir_render_all` turns the packed words back into the " +
        "mnemonic listing used by `--dump=ir` and `--emit=asm`.\n\n" +
        "## Operand kinds\n\n" +
        "| constant | wire | meaning |\n|---|---|---|\n";
    foreach (op in ir_schema.IR_OPERANDS) {
        out += "| `O_" + op.name + "` | `" + op.wire + "` | " + operand_note(op.name) + " |\n";
    };
    out += "\n`w` is one numeric word and `l` is one interned label id.\n\n" +
        "## From packed words to a listing\n\n" +
        "`mov $1, %rax` is one `F_MOV_I_R` item, form id " + tostring(movid) + ".\n" +
        "Its eight words are:\n\n" +
        "```text\n" +
        "[" + tostring(movid) + ", 1, 0, 64, 0, 0, 0, 0]\n" +
        " |  |  |   |\n" +
        " |  |  |   +-- REG width (64 bits)\n" +
        " |  |  +------ REG number (0 = %rax)\n" +
        " |  +--------- IMM value\n" +
        " +------------ form id (F_MOV_I_R)\n" +
        "```\n\n" +
        "The remaining four words are padding: every item has seven operand\n" +
        "slots, and this form's operands use only three. A label operand\n" +
        "instead stores an interned label id, which is why the listing can\n" +
        "print names while the packed stream stays numeric.\n\n" +
        "## Forms\n\n" +
        "| id | constant | mnemonic | operands | wire |\n|---:|---|---|---|---|\n";
    for i in 0..len(ir_schema.IR_FORMS) {
        let fr = form_row(ir_schema.IR_FORMS[i]);
        let ops: [str] = [];
        let wire = "";
        foreach (op in fr.operands) {
            ops += "`" + op + "`";
            wire += operand_wire(op);
        };
        out += "| " + tostring(i) + " | `F_" + fr.name + "` | `" + fr.mnemonic + "` | " +
            join(ops, ", ") + " | `" + wire + "` |\n";
    };
    out
};

def dispatch_shape(binding: str) -> str {
    let at = index_of(binding, ":");
    if (at < 0) { "?" } else { trim(binding[at + 1:]) }
};

def dispatch_binding(binding: str) -> str {
    let at = index_of(binding, ":");
    if (at < 0) { "" } else { trim(binding[:at]) }
};

def dispatch_md() -> str {
    let out = header("Native code-generation dispatch", "src/y/dispatch_schema.y") +
        "`native_dispatch.y` expands `NATIVE_DISPATCH` into `gen_go`, the " +
        "`Node -> EmitSt` function at the center of code generation. The table " +
        "is ordered: the first matching `k` wins, and the final arm calls the " +
        "special-node handler.\n\n" +
        "Rows are `KIND[ KIND...]|BINDING: SHAPE|CALL`. The kind column names " +
        "`tags.y` constants (`K.num`), the binding is the exact record the arm " +
        "casts to, and the call is the handler the arm invokes.\n\n" +
        "| node kind | shape | handler call |\n|---|---|---|\n";
    foreach (row in dispatch_schema.NATIVE_DISPATCH) {
        let parts = split(row, "|");
        let kinds = split(parts[0], " ");
        let shape = dispatch_shape(parts[1]);
        let binding = dispatch_binding(parts[1]);
        let call = if (len(parts) > 2) { parts[2] } else { "" };
        for i in 0..len(kinds) {
            let b = if (binding == "") { "" } else { " as `" + binding + "`" };
            out += "| `K." + kinds[i] + "` | `" + shape + "`" + b + " | `" + call + "` |\n";
        };
    };
    out += "| _anything else_ | | `" + dispatch_schema.NATIVE_DISPATCH_OTHERWISE + "` |\n";
    out + "\nThe same generator (`dispatch_codegen.y`'s `meta_tag_dispatch`) " +
        "also emits the checker's and linter's dispatch tables, from " +
        "`check_dispatch.y` and `lint_dispatch.y`.\n"
};

def write(path: str, text: str) -> bool {
    if (!fs.write_file(path, text)) {
        eputs("compiler_docs: cannot write '" + path + "'\n");
        false
    } else {
        true
    }
};

def main(args: [str]) -> long {
    let out = "docs/compiler/generated";
    if (len(args) > 1) { out = args[1]; };
    if (!fs.make_dirs(out) && !fs.is_dir(out)) {
        eputs("compiler_docs: cannot make '" + out + "'\n");
        exit(1);
    };
    let ok = write(out + "/ast.md", ast_md()) &&
        write(out + "/types.md", types_md()) &&
        write(out + "/ir.md", ir_md()) &&
        write(out + "/dispatch.md", dispatch_md());
    if (!ok) { exit(1); };
    eputs("compiler_docs: wrote " + out + "/{ast,types,ir,dispatch}.md\n");
    0
};

region { exit(main(argv())); }
