{
  "name": "y-lang",
  "displayName": "Y Language Support",
  "description": "Language server for the Y programming language (ycc): diagnostics, semantic highlighting, formatting",
  "version": "0.2.0",
  "publisher": "yun",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:y"
  ],
  "contributes": {
    "languages": [
      {
        "id": "y",
        "aliases": [
          "Y",
          "y"
        ],
        "extensions": [
          ".y"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Y",
      "properties": {
        "y.lsp.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `yserve` binary. Leave empty to search next to the extension, then the workspace root, then `$PATH`."
        },
        "y.lsp.rootPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Workspace root passed to `yserve` as `--root`. Imports in an open file resolve against the file's own directory first, so this only matters for files outside the workspace. Empty uses the server's working directory."
        },
        "y.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the JSON-RPC traffic between VS Code and yserve to the Y output channel."
        }
      }
    },
    "commands": [
      {
        "command": "y.formatDocument",
        "title": "Y: Format Document",
        "category": "Y"
      },
      {
        "command": "y.restartLanguageServer",
        "title": "Y: Restart Language Server",
        "category": "Y"
      },
      {
        "command": "y.showServerOutput",
        "title": "Y: Show Server Output",
        "category": "Y"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
