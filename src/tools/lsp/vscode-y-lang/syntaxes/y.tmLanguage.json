{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Y",
  "scopeName": "source.y",
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#def-name"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#self"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.y",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "comment.block.y",
              "match": "\\*/"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.y",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.y",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        {
          "name": "string.quoted.other.y",
          "begin": "\\b[bf]\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.y",
          "begin": "\\b[bc]'",
          "end": "'",
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.hex.y",
          "match": "\\\\x[0-9a-fA-F]{2}"
        },
        {
          "name": "constant.character.escape.y",
          "match": "\\\\[ntr\\\\\"'{}]"
        },
        {
          "name": "constant.character.escape.y",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hex.y",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.integer.binary.y",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.float.y",
          "match": "\\b\\d[\\d_]*\\.[\\d_]+([eE][+-]?\\d[\\d_]*)?"
        },
        {
          "name": "constant.numeric.float.y",
          "match": "\\b\\d[\\d_]*[eE][+-]?\\d[\\d_]*"
        },
        {
          "name": "constant.numeric.integer.y",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "def-name": {
      "patterns": [
        {
          "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.y"
            },
            "2": {
              "name": "entity.name.function.y"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.y",
          "match": "\\b(if|else|while|for|foreach|in|return|break|continue|match|spawn|fork|lock|try_lock|join|post|wait|mutex|sem|packed|bits)\\b"
        },
        {
          "name": "keyword.control.region.y",
          "match": "\\b(region|heap)(?=\\s*\\{)"
        },
        {
          "name": "keyword.control.import.y",
          "match": "\\b(import|embed|from|export)\\b"
        },
        {
          "name": "storage.type.y",
          "match": "\\b(let|const|type)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.y",
          "match": "\\b(true|false|none)\\b"
        }
      ]
    },
    "self": {
      "patterns": [
        {
          "name": "variable.language.y",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.y",
          "match": "\\b(long|int|byte|bool|str|float|bigint|void|mutex|sem|i8|u8|i16|i16le|i16be|u16|u16le|u16be|i32|i32le|i32be|u32|u32le|u32be|i64|i64le|i64be|u64|u64le|u64be)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.y",
          "match": "\\b(print|syscall|len|sizeof|offsetof|push|some|is_some|unwrap|values|trim|ord|byte_at|chr|tolong|tofloat|tostring|index_of|mod|prepend|last_index_of|join|split|puts|eputs|clock_us|time_us|sleep|heap_used|keys|spawn|fork|wait_pid|mutex|sem|lock|try_lock|post|wait|exit|argv|range|typeof|bytes|from_bytes|ptr_addr|ptr_from|os_call|jmp_at)\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.y",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.y",
          "match": ">>>=|<<=|>>=|>>>|&&|\\|\\||==|!=|<=|>=|::|\\.\\.|->|=>|\\?\\.|\\+\\+|--|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<|>>|[+\\-*/%<>!=&|^~?]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.y",
          "match": "[;,:]"
        },
        {
          "name": "punctuation.bracket.y",
          "match": "[{}()\\[\\]]"
        }
      ]
    }
  }
}
