// The hosted bootstrap uses the same byte-buffer primitives as native Y.
ndef y_bytes_zero(n: long) -> [byte] = "y_bytes_zero";
ndef y_copy_fwd(dst: *byte, src: *byte, n: long) -> long = "y_copy_fwd";
let data = y_bytes_zero(12);
let prefix = bytes("ab");
y_copy_fwd(data.ptr, prefix.ptr, 2);
y_copy_fwd(data.ptr + 2, data.ptr, 8);
print(from_bytes(data[:10]));
let tail = data[8:10];
tail[0] = 120;
print(from_bytes(tail), from_bytes(data[8:10]));
data += bytes("cd");
print(data.pop(), data.length, 99 in data);
let boxed: [byte] = [97, 98];
print(bytes("ab") == data[:2], data[:2] == boxed);
let fixed: [byte; 4] = [0; 4];
y_copy_fwd(fixed.ptr, data.ptr + 6, 4);
print(from_bytes(fixed));
let saved = fixed.ptr;
fixed[0] = 120;
y_copy_fwd(data.ptr, saved, 4);
print(from_bytes(data[:4]));
let words: [long; 1] = [0; 1];
let word_bytes: *byte = ptr_from(ptr_addr(words.ptr));
y_copy_fwd(word_bytes, data.ptr, 4);
print(words[0] == 1650549368);
words[0] = 1684234849;
y_copy_fwd(data.ptr, word_bytes, 4);
print(from_bytes(data[:4]));
let empty = bytes("");
print(from_bytes(empty), len(empty));
