// ARGUMENTS through execve.  Run with three words, this prints them, then replaces
// itself with /prog carrying ["prog", "hello"]; the replacement has two words and
// prints those.  The word "hello" therefore appears ONLY if argv crossed execve.
let a = argv();
print("sh n=" + tostring(len(a)) + " a1=" + a[1] + "\n");
if (len(a) >= 3) {
    let args: [str] = [];
    args += "prog";
    args += "hello";
    let p: [byte] = [];
    let s = "/prog";
    let i = 0;
    while (i < len(s)) { p += s[i] & 255; i = i + 1; };
    p += 0;
    let r = syscall(59, ptr_addr(&p[0]), ptr_addr(&args[0]));
    print("exec failed " + tostring(r) + "\n");
} else {
    print("done\n");
};
