import lexer from "../../../src/y/lexer.y";
import parser from "../../../src/y/parser.y";

let src = "def add(a: long, b: long) { a + b }; print(add(3, 4 * 2));";
let toks = lexer.tokenize(src);
let ast = parser.parse_program(toks);
print("top kind = " + ast.k);
let stmts = ast.stmts;
print("stmt count = " + tostring(len(stmts)));
let s0 = stmts[0];
print("stmt0 kind = " + s0.k);
print("stmt0 name = " + s0.name);
let params = s0.v.params;
print("stmt0 params = " + tostring(params));
let s1 = stmts[1];
print("stmt1 kind = " + s1.k);
let callee = s1.callee;
print("stmt1 callee = " + callee.v);
let args = s1.args;
let arg0 = args[0];
print("stmt1 arg0 kind = " + arg0.k);
let inner_callee = arg0.callee;
print("stmt1 arg0 callee = " + inner_callee.v);
let inner_args = arg0.args;
let ia0 = inner_args[0];
let ia1 = inner_args[1];
print("stmt1 arg0 arg0 = " + ia0.v);
print("stmt1 arg0 arg1 kind = " + ia1.k + " op=" + ia1.op);
print("ALL PARSER CHECKS PASSED");
