[a()b] on [ab] -> [ab] at 0 | groups [] | spans 1..1 | caps 0,2,1,1
[(x)?(y)] on [y] -> [y] at 0 | groups - [y] | spans -1..-1 0..1 | caps 0,1,-1,-1,0,1
