[(a)] on [a] -> [a] at 0 | groups [a] | spans 0..1 | caps 0,1,0,1
[(a)(b)] on [ab] -> [ab] at 0 | groups [a] [b] | spans 0..1 1..2 | caps 0,2,0,1,1,2
[((a)(b))] on [ab] -> [ab] at 0 | groups [ab] [a] [b] | spans 0..2 0..1 1..2 | caps 0,2,0,2,0,1,1,2
[(a(b(c)))] on [abc] -> [abc] at 0 | groups [abc] [bc] [c] | spans 0..3 1..3 2..3 | caps 0,3,0,3,1,3,2,3
[(a)(b)(c)] on [abc] -> [abc] at 0 | groups [a] [b] [c] | spans 0..1 1..2 2..3 | caps 0,3,0,1,1,2,2,3
[(?:a)(b)] on [ab] -> [ab] at 0 | groups [b] | spans 1..2 | caps 0,2,1,2
[(a)(?:b)(c)] on [abc] -> [abc] at 0 | groups [a] [c] | spans 0..1 2..3 | caps 0,3,0,1,2,3
[(?<year>\d{4})-(?<month>\d{2})] on [2026-10] -> [2026-10] at 0 | groups [2026] [10] | spans 0..4 5..7 | caps 0,7,0,4,5,7
[(?<year>\d{4})-(?<month>\d{2})-(?<day>\d{2})] on [2026-10-04] -> [2026-10-04] at 0 | groups [2026] [10] [04] | spans 0..4 5..7 8..10 | caps 0,10,0,4,5,7,8,10
