// pow, in assembly, against the Y it replaces: bit for bit, over 10k pairs.
//
// src/y/arch/math.s's y_pow is generated by `ytest math-gen pow` from
// std/math.y's own constants, and it walks pow_pos's three subroutines -- the
// logarithm in two parts, the exponent in two parts, exp2 of the pair -- in the
// same order the Y does. The promise is not "close to" but "the same double",
// and it is a harder promise here than for sin and cos: pow is the one function
// in the module that cannot take its logarithm's answer at face value, because
// it multiplies that answer by the exponent, and one ulp of an exponent of 500
// is 5.7e-14 of the result. Every stage therefore carries what its own
// computation rounded off, and a dropped low half shows up as hundreds of ulps
// rather than one.
//
// The corpus reaches every arm of pow_y's dispatch: the exponent-zero arm, the
// NaN arm, the +-1 bases and the parity that decides (-1)^y, x itself at y == 1,
// the zero base with its signed answer and its negative-exponent infinity, both
// infinities and the parity that belongs to the BASE being negative, a negative
// base with a fractional exponent (nan), the integer-exponent path at both ends
// of +-1024, and the negative base past 1024 where the logarithm carries it and
// the sign goes on afterwards. It then walks the general path across the whole
// range of bases and exponents, subnormal through overflow.
import math;

// One bit of difference: enough to say "the same double", and it keeps -0.0 and
// +0.0 apart, which `==` does not.
def same(a: float, b: float) -> bool {
    math.fbits(a) == math.fbits(b)
};

def pat(x: float) -> str {
    let h = "";
    let d = "0123456789abcdef";
    let n = math.fbits(x);
    let shift = 60;
    while (shift >= 0) {
        let nib = (n >> shift) & 15;
        h += d[nib:nib + 1];
        shift = shift - 4;
    };
    h
};

let bad = 0;
let n = 0;

def check(x: float, y: float) -> void {
    let a = math.pow(x, y);
    let b = math.pow_y(x, y);
    n = n + 1;
    if (!same(a, b)) {
        bad = bad + 1;
        if (bad < 12) {
            print(f"pow x={x:<24.17} y={y:<24.17} asm {pat(a)} y {pat(b)}");
        }
    }
};

// ── the edges, one per arm ────────────────────────────────────────────────
let inf = 1.0 / 0.0;
let nan = math.nan;
check(2.0, 0.0);                  // y == 0: 1.0, and it comes first for every x
check(0.0 - 2.0, 0.0 - 0.0);      // -0.0 exponent: the same arm
check(2.0, -1.0);
check(nan, 2.0);                  // NaN base
check(2.0, nan);                  // NaN exponent
check(nan, nan);
check(1.0, 1024.0);               // x == 1.0: always 1.0, whatever the exponent
check(0.0 - 1.0, 0.5);            // (-1)^0.5 == 1: the arm a "negative base,
check(0.0 - 1.0, 2.5);            // fractional exponent" rule gets wrong
check(0.0 - 1.0, 1024.0);
check(0.0 - 1.0, 1025.0);
check(0.0 - 1.0, inf);
check(3.0, 1.0);                  // y == 1 answers x itself
check(nan, 1.0);
check(0.0, 2.0);                  // the zero base: the sign follows the parity
check(0.0 - 0.0, 2.0);
check(0.0, 3.0);
check(0.0, -1.0);                 // and a negative exponent is +inf, not +-0
check(0.0 - 0.0, -1.0);
check(0.0, 0.5);                  // a fractional exponent on a zero base
check(inf, 2.0);
check(inf, 3.0);                  // a positive infinity is positive for any
check(inf, -1.0);                 // exponent, and a negative one takes the sign
check(0.0 - inf, 2.0);
check(0.0 - inf, 3.0);
check(0.0 - inf, 4.0);
check(inf, 0.5);
check(0.0 - 2.0, 0.5);            // a negative base needs an integer exponent
check(0.0 - 2.0, -0.5);
check(0.0 - 2.0, 1024.0);         // the integer path at its upper end
check(0.0 - 2.0, -1024.0);
check(0.0 - 2.0, 1025.0);         // and the logarithm's path just past it, with
check(0.0 - 2.0, -1025.0);        // the parity deciding the sign
check(0.0 - 2.0, 1026.0);
check(0.0 - 2.0, 1100.0);         // far enough that the answer is an infinity
check(0.0 - 1e300, 1025.0);
check(2.0, 1024.0);
check(2.0, 0.5);
check(2.0, 1.0e-300);
check(5.0e-324, 0.5);              // the least subnormal as a base
check(1.0e-310, 3.0);
check(1.0e300, 0.5);              // and as an exponent: the case where rounding
check(2.0, 1.0e300);              // the exponent first is 49 ulps
check(1.0e300, 1.0e300);
check(2.0, 0.9999999999999999);
check(2.0, 1.0000000000000002);
check(1.0000000000000002, 1.0e15);
check(0.9999999999999999, 1.0e15);
check(2.0, inf);
check(2.0, 0.0 - inf);

// ── the integer path: every bit of the exponent matters ───────────────────
// pow_int is repeated squaring, so its answers come out of as many rounded
// multiplies as the exponent's bits -- an exponent with a different bit pattern
// is a different sequence of roundings, and both sides must do the same one.
let e = -8;
while (e <= 8) {
    check(1.7, e + 0.0);
    check(0.0 - 1.7, e + 0.0);
    check(1.0e-3, e + 0.0);
    e = e + 1
};
// and every exponent at both ends of the +-1024 window the Y uses
let f = -4;
while (f <= 4) {
    check(1.3, 1020.0 + f);
    check(1.3, 0.0 - (1020.0 + f));
    check(0.0 - 1.3, 1020.0 + f);
    check(0.0 - 1.3, 0.0 - (1020.0 + f));
    f = f + 1
};

// ── the general path, across the whole range ─────────────────────────────
// 5000 pairs: a base over 2^(v*105 - 52) covers the subnormals, 1, and the top
// of the range, and an exponent over +-1200 covers the overflow and flush edges
// of exp2_corr from both sides.
let i = 0;
let v = 0.5;
while (i < 5000) {
    v = (v + 1.0) * 0.6180339887498949;
    v = v - math.floor(v);
    let x = math.pow(2.0, v * 105.0 - 52.0);
    let w = (v * 2.0 - 1.0) * 1200.0;
    // a negative base on the general path too: the exponent is an integer only
    // now and then, which is the arm that decides between nan and the log path
    check(x, w);
    check(0.0 - x, math.floor(w));
    check(0.0 - x, w);
    i = i + 1
};

// ── and the answers are right, not merely equal ────────────────────────────
// Bit-identity with the Y is only half the promise; the Y is checked against the
// platform's libm in test/math/ulp_table.txt. These are the identities an
// implementation can only pass by being right.
print(f"pow(2, 0.5)  - sqrt(2) = {math.pow(2.0, 0.5) - 1.41421356237309504880:.3e}");
print(f"pow(10, 5)   = {math.pow(10.0, 5.0):.17}");
print(f"pow(1.5, 2.5)= {math.pow(1.5, 2.5):.17}");
print(f"pow(2, 1023) - 2^1023   = {math.pow(2.0, 1023.0) - 8.98846567431157953865e307:.3e}");
print(f"pow(0, 0)    = {math.pow(0.0, 0.0):.17}");
print(f"pow(-2, 3)   = {math.pow(0.0 - 2.0, 3.0):.17}");
print(f"pow(0, 2)    = {math.pow(0.0, 2.0):.17}");
print(f"pow(0, 3)    = {math.pow(0.0, 3.0):.17}");
// (x^y)^(1/y) == x for y != 0: the round trip is what fails when a low half is
// dropped, because the answer comes back a few ulps out
let t = math.pow(1.7, 7.0);
let back = math.pow(t, 1.0 / 7.0);
print(f"(1.7^7)^(1/7) - 1.7 = {back - 1.7:.3e}");
print(f"{n} pairs, {bad} differing");