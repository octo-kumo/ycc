// sin and cos, in assembly, against the Y loops they replace: bit for bit, over
// 10k arguments each.
//
// src/y/arch/math.s's y_sin/y_cos are generated by `ytest math-gen sin` from
// std/math.y's own constants and walk the same operations in the same order, so
// the promise is not "close to" but "the same double". The corpus reaches every
// branch: a NaN, both infinities, the |x| <= pi/4 shortcut and the point either
// side of its edge, the reduction, all four quadrants and both signs of n, the
// rotation the selection does, the sign flip, a subnormal argument, and the
// argument large enough that n*pio2_1 needs its compensation.
import math;

// One bit of difference: enough to say "the same double", and it keeps -0.0 and
// +0.0 apart, which `==` does not.
def same(a: float, b: float) -> bool {
    math.fbits(a) == math.fbits(b)
};

def pat(x: float) -> str {
    let h = "";
    let d = "0123456789abcdef";
    let n = math.fbits(x);
    let shift = 60;
    while (shift >= 0) {
        let nib = (n >> shift) & 15;
        h += d[nib:nib + 1];
        shift = shift - 4;
    };
    h
};

let bad = 0;
let n = 0;

def check(x: float) -> void {
    let a = math.sin(x);
    let b = math.sin_y(x);
    let c = math.cos(x);
    let d = math.cos_y(x);
    n = n + 1;
    if (!same(a, b)) {
        bad = bad + 1;
        if (bad < 12) {
            print(f"sin x={x:<24.17} asm {pat(a)} y {pat(b)}");
        }
    };
    if (!same(c, d)) {
        bad = bad + 1;
        if (bad < 12) {
            print(f"cos x={x:<24.17} asm {pat(c)} y {pat(d)}");
        }
    }
};

// ── the edges, one per branch ─────────────────────────────────────────────
check(0.0);
check(0.0 - 0.0);                 // -0.0: the negation is 0.0 - x, not a sign flip
check(1.0);
check(0.0 - 1.0);
check(0.5);
check(math.nan);
check(1.0 / 0.0);
check(0.0 - (1.0 / 0.0));
check(5.0e-324);                  // the least subnormal: inside the shortcut
check(1.0e-310);
check(1.0e-8);
// the shortcut's edge, from both sides and at the edge itself
let p4 = 0.78539816339744830961;
check(p4);
check(0.0 - p4);
check(math.nextafter(p4, 1.0 / 0.0));
check(math.nextafter(p4, 0.0 - (1.0 / 0.0)));
check(math.nextafter(0.0 - p4, 1.0 / 0.0));
check(math.nextafter(0.0 - p4, 0.0 - (1.0 / 0.0)));
// pi/2, pi and both signs: n = 1, 2 and the quadrant that follows
let hp = 1.57079632679489661923;
check(hp);
check(0.0 - hp);
check(hp + hp);
check(0.0 - (hp + hp));
check(3.0 * hp);
check(0.0 - 3.0 * hp);
check(100.0);
check(0.0 - 100.0);
check(1000.0);
check(1000000.0);
check(1.0e15);
check(4.503599627370496e15);     // 2^52, where the reduction's compensation ends
check(0.0 - 4.503599627370496e15);

// ── every quadrant, both signs of n, and the selection's two tests ────────
// x = k*(pi/2) plus a small offset walks n through every integer and every
// quadrant, and the offset decides which of the four the answer comes from.
let k = -12;
while (k <= 12) {
    let q = k * hp;
    check(q);
    check(q + 0.3);
    check(q - 0.3);
    check(q + 1.0e-9);
    check(0.0 - q);
    check(0.0 - (q + 0.3));
    check(q * 1000.0);
    check(q * 100000.0);
    k = k + 1
};

// ── where the reduction's compensation starts to matter ───────────────────
// n*pio2_1 loses its last bits once n passes 2^21 and n*pio2_1t once n passes
// 2^10, so both sides of each are in the corpus; the argument is written as a
// multiple of pi/2 so that n lands near the power in question.
let j = 0;
while (j < 60) {
    let e = j - 30;
    let m = hp * math.pow(2.0, e);
    check(m);
    check(m + 1.0e-6);
    check(0.0 - m);
    j = j + 1
};

// ── the spread: 10000 arguments, deterministic ─────────────────────────────
let i = 0;
let v = 0.5;
while (i < 5000) {
    v = (v + 1.0) * 0.6180339887498949;
    v = v - math.floor(v);
    // v in [0, 1) -> x = +-2^(v*105 - 52), which covers the subnormals, the
    // shortcut's neighbourhood, every quadrant and the top of the range
    let m = math.pow(2.0, v * 105.0 - 52.0);
    check(m);
    check(0.0 - m);
    i = i + 1
};

// ── and the answers are right, not merely equal ────────────────────────────
// Bit-identity with the Y is only half the promise; the Y is checked against the
// platform's libm in test/math/ulp_table.txt. These are the identities an
// implementation can only pass by being right.
print(f"sin(pi/6) - 0.5 = {math.sin(0.52359877559829887308) - 0.5:.3e}");
print(f"cos(pi/3) - 0.5 = {math.cos(1.04719755119659774615) - 0.5:.3e}");
print(f"sin(1e6)       = {math.sin(1000000.0):.17}");
print(f"cos(1e6)       = {math.cos(1000000.0):.17}");
print(f"sin(0)         = {math.sin(0.0):.17}");
print(f"sin(-0.0)      = {math.sin(0.0 - 0.0):.17}");
// sin^2 + cos^2 == 1 to the last bit the products allow, at arguments where the
// reduction has already run: the two kernels are independent, so this only holds
// if both are right
let t = 7.0;
let r = math.sin(t) * math.sin(t) + math.cos(t) * math.cos(t) - 1.0;
print(f"sin^2+cos^2-1 at 7.0 = {r:.3e}");
print(f"{n} arguments, {bad} differing");
