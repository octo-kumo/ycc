// log, in assembly, against the Y loop it replaces: bit for bit, over 10k
// arguments.
//
// src/y/arch/math.s's y_log is generated by test/math/gen_log.py from
// std/math.y's own constants and walks the same operations in the same order, so
// the promise is not "close to" but "the same double". The corpus reaches every
// branch: NaN, below zero, zero (both signs), an infinity, the subnormal band
// where frexp doubles until the field is not 0, the point where the fraction
// crosses 1/sqrt(2) and the exponent steps down, and both ends of the range.
import math;

// One bit of difference: enough to say "the same double", and it keeps -0.0 and
// +0.0 apart, which `==` does not. A NaN compares equal to itself in the sense
// that matters here (same pattern), so is_nan does not enter into it.
def same(a: float, b: float) -> bool {
    math.fbits(a) == math.fbits(b)
};

def pat(x: float) -> str {
    let h = "";
    let d = "0123456789abcdef";
    let n = math.fbits(x);
    let shift = 60;
    while (shift >= 0) {
        let nib = (n >> shift) & 15;
        h += d[nib:nib + 1];
        shift = shift - 4;
    };
    h
};

let bad = 0;
let n = 0;

def check(x: float) -> void {
    let a = math.log(x);
    let b = math.log_y(x);
    n = n + 1;
    if (!same(a, b)) {
        bad = bad + 1;
        if (bad < 12) {
            print(f"x={x:<24.17} asm {pat(a)} y {pat(b)}");
        }
    }
};

// ── the edges, one per branch ─────────────────────────────────────────────
check(0.0);
check(0.0 - 0.0);
check(1.0);
check(2.0);
check(0.5);
check(0.0 - 1.0);                 // below zero: NaN
check(math.nan);
check(1.0 / 0.0);
check(0.0 - (1.0 / 0.0));
check(1.7976931348623157e308);    // and the largest finite in
check(5.0e-324);                  // the least subnormal: frexp doubles it 52 times
check(1e-320);
check(2.2250738585072014e-308);   // the least normal
check(2.225073858507201e-308);    // one below it, still subnormal
check(1.0 / 3.0);
check(0.75);
check(math.e);
// the fraction crossing 1/sqrt(2): log's reduction doubles the fraction and
// takes one off the exponent there, so both sides of it matter
let is2 = 0.70710678118654752440;
let k = 0;
while (k < 300) {
    check(is2 * math.pow(2.0, k - 150));
    check(is2 * math.pow(2.0, k - 150) * (1.0 - 1e-16));
    check(is2 * math.pow(2.0, k - 150) * (1.0 + 1e-16));
    k = k + 1;
};
// the subnormal band, where the answer is large and negative
let s = 0;
while (s < 200) {
    check(1e-310 * (1.0 + s * 0.01));
    check(5.0e-324 * (1.0 + s));
    s = s + 1;
};

// ── the spread: 9000 arguments, deterministic ──────────────────────────────
let i = 0;
let v = 0.5;
while (i < 9000) {
    v = (v + 1.0) * 0.6180339887498949;
    v = v - math.floor(v);
    // v in [0, 1) -> x = 2^(v*2046 - 1023), which covers every decade log has an
    // answer in and lands on the subnormals and the top of the range for free
    check(math.pow(2.0, v * 2046.0 - 1023.0));
    i = i + 1;
};

// ── and the answers are right, not merely equal ────────────────────────────
// Bit-identity with the Y is only half the promise; the Y is checked against the
// platform's libm in test/math/ulp_table.txt. These are the identities an
// implementation can only pass by being right.
print(f"ln(2)   = {math.log(2.0):.17}");
print(f"ln(e)   = {math.log(math.e):.17}");
print(f"log(exp(7)) - 7 = {math.log(math.exp(7.0)) - 7.0:.3e}");
print(f"log2(1024) - 10 = {math.log2(1024.0) - 10.0:.3e}");
print(f"log10(1e6) - 6 = {math.log10(1.0e6) - 6.0:.3e}");
print(f"{n} arguments, {bad} differing");