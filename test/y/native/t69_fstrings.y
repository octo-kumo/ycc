// no spec is tostring: a float shows six decimals, a bool its name;
// a float spec without a type is f (Python's would be repr-like)
print(f"{fpi} {f3} {true} {false:>6}|{[1, 2]} {some(3)}");
print(f"[{fpi:10}] [{fpi:.2}] [{fnz:08}] [{f3:<10}]");
// fields hold any expression: calls, methods, ternaries, literals
// with braces and colons, slices, records, nested f-strings
let n = 1;
print(f"{n} item{n == 1 ? "" : "s"}, {n + 1} item{n + 1 == 1 ? "" : "s"}");
print(f"{"}:{"} {sabc[1:3]} {shello.upper():>12} {len(shello):03}");
let r = { k: "v", w: 7 };
print(f"{r.k}={r.w:+} {{r}} {f"<{r.w:x}>":^9}|");
print(f"tab\there\{not a field\} {{x}} \x41 {"q\"q"}");
print(f"{
    n * 100
    :>8}|");
let b: byte = 'z';
print(f"{b} {b:x} {b:c} {b:.1f}");
def money(v: float) -> str { f"${v:,.2f}" };
print(money(1234567.891), " ", money(0.005), " ", money(0.015));
let rows = [["apple", "1.5"], ["kiwi", "12.25"]];
foreach (row in rows) {
    print(f"|{row[0]:<8}|{row[1]:>7}|");
};
print(f"");
