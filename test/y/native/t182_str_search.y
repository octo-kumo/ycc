let hay = "";
let needle = "";
let miss = "";
// The search behind count, replace and last_index_of is KMP now (str.y
// y_str_fail / y_str_scan): one failure table per search turns "does the needle
// match here" from a needle-length comparison into one comparison, so a scan
// costs the haystack rather than the haystack times the needle. The needle
// cases are what could break -- a needle that overlaps itself, an empty one, a
// needle longer than the haystack -- and the long ones are the shapes the old
// scan was quadratic on (a periodic haystack, where every other offset is a
// needle-length near miss).
print("aaaa".last_index_of("aa"), " ", "abababa".last_index_of("aba"), " ",
      "aaaa".last_index_of("a"), " ", "ababababab".last_index_of("abab"));
print("aaa".last_index_of(""), " ", "aaa".last_index_of("aaaa"), " ",
      "aaa".count(""), " ", "aaa".replace("", "x"), " ", "abc".replace("abcd", "x"));
print("aaaaa".count("aa"), " ", "aaaaa".replace("aa", "b"), " ",
      "ababab".count("ab"), " ", "ababab".replace("ab", "-"));
print(hay.count(needle), " ", hay.last_index_of(needle), " ",
      hay.count(miss), " ", hay.last_index_of(miss), " ",
      len(hay.replace(miss, "x")), " ", len(hay.replace(needle, "x")));
print(hay.count("ab"), " ", hay.last_index_of("ab"), " ", hay.last_index_of("ba"));
