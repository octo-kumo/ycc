// The unrolled polynomial kernels, against the loop they replaced.
//
// Eight kernels in src/y/std/math.y -- poly_exp, poly_log, poly_sinh, poly_tanh,
// poly_atan, poly_asin, poly_sin, poly_cos -- are GENERATED by
// `ytest math-unroll` and carry a comment naming a gate: "t321_split_unrolled.y is the gate: it asks both forms the same questions
// and requires the same bits." That file did not exist. There is no
// t321_split_unrolled.y -- t321 is about rotl -- so the four forms have been
// carried with a signpost to nowhere since they were written, and the gate the
// comments promise, the one that says the generated chain and the loop it
// replaces agree TO THE BIT, was the generator's own Python check and nothing in
// Y at all.
//
// This is that gate. It asks both forms the question the ulp table cannot: the
// table sees the ANSWER, so a kernel that drifts by half an ulp over a hundred
// arguments can hide inside a final rounding. Asked directly, the drift is
// visible, and comparing is exact because fbits of a kernel is exact where fbits
// of a transcendental is not.
//
// Why bit-for-bit and not within one ulp: the unrolled form performs the SAME
// operations in the SAME order as the loop, so anything but equality is a defect
// -- a coefficient read from the wrong line, a range off by one, a dropped sign in
// a low half, a reassociation. Every count below must be zero. There is no
// tolerance here, and adding one would be the wrong kind of kindness: it would
// let the two halves of a defect pass.

import math;

// Counted across the whole file rather than returned, because Y has no function
// values: a sweep cannot be handed a kernel to compare against. So each kernel
// gets its own loop and each calls `probe`, which is the one thing they share.
let bad = 0;
let asked = 0;

def probe(hi: [float], lo: [float], w: float, unrolled: float) -> void {
    asked = asked + 1;
    if (math.fbits(math.poly_split(hi, lo, w)) != math.fbits(unrolled)) {
        bad = bad + 1
    }
};

// 4002 arguments each: both signs, both ends, and a spread dense enough that a
// coefficient which only matters for one subrange cannot slip through. The zero
// is asked explicitly -- there the answer is the leading pair exactly, so any
// reassociation shows first and a chain that merely agrees elsewhere still fails.
//
// Each kernel is asked over ITS OWN domain, which is what the caller guarantees,
// and then PAST it, deliberately, out to 0.5. The chains are polynomials: they
// are defined everywhere, and the unrolled and looped forms must be the same
// polynomial whether or not a caller happens to stay inside. A generator that
// only agreed inside the domain could be emitting a different chain and no caller
// would ever notice -- which is the shape of the defect the named-and-missing
// gate was letting through.
//
//   poly_exp(w)   expm1/exp2_corr/exp_half: r = x - k*ln2, |r| <= ln(2)/2
//   poly_log(w)   log1p/log2_dd:            z = w/(1+w) <= 1/4
//   poly_sinh(w)  sinh_small:               |x| <= 0.5
//   poly_tanh(w)  tanh_small:               |x| <= 0.5
//   poly_atan(w)  atan_kernel:              |x| <= tan(pi/8), so w <= 0.1716
//   poly_asin(w)  asin_half:                z = (1-a)/2 <= 1/4
//   poly_sin(w)   sin_cos_k, via tan:       |x| <= pi/4,   so w <= 0.6169
//   poly_cos(w)   sin_cos_k, via tan:       |x| <= pi/4,   so w <= 0.6169

let n = 2000;

let i = 0;
while (i <= n) {
    let t = i / n;

    // (pi/4)^2 -- the widest domain any of the eight is called with, from
    // sin_cos_k. Everything else is asked over the same spread, which covers
    // each one's own domain and goes past it.
    let w = 0.61685 * t;
    let m = 0.0 - w;

    probe(math.exp_k, math.exp_kl, w, math.poly_exp(w));
    probe(math.exp_k, math.exp_kl, m, math.poly_exp(m));
    probe(math.log_k, math.log_kl, w, math.poly_log(w));
    probe(math.log_k, math.log_kl, m, math.poly_log(m));
    probe(math.sinh_k, math.sinh_kl, w, math.poly_sinh(w));
    probe(math.sinh_k, math.sinh_kl, m, math.poly_sinh(m));
    probe(math.tanh_k, math.tanh_kl, w, math.poly_tanh(w));
    probe(math.tanh_k, math.tanh_kl, m, math.poly_tanh(m));
    probe(math.atan_k, math.atan_kl, w, math.poly_atan(w));
    probe(math.atan_k, math.atan_kl, m, math.poly_atan(m));
    probe(math.asin_k, math.asin_kl, w, math.poly_asin(w));
    probe(math.asin_k, math.asin_kl, m, math.poly_asin(m));
    probe(math.sin_k, math.sin_kl, w, math.poly_sin(w));
    probe(math.sin_k, math.sin_kl, m, math.poly_sin(m));
    probe(math.cos_k, math.cos_kl, w, math.poly_cos(w));
    probe(math.cos_k, math.cos_kl, m, math.poly_cos(m));

    i = i + 1
};

// The zero, asked once per kernel on its own: at w = 0 every chain collapses to
// its leading pair, so this is where a chain with one term missing is caught even
// if every other argument happened to agree.
probe(math.exp_k, math.exp_kl, 0.0, math.poly_exp(0.0));
probe(math.log_k, math.log_kl, 0.0, math.poly_log(0.0));
probe(math.sinh_k, math.sinh_kl, 0.0, math.poly_sinh(0.0));
probe(math.tanh_k, math.tanh_kl, 0.0, math.poly_tanh(0.0));
probe(math.atan_k, math.atan_kl, 0.0, math.poly_atan(0.0));
probe(math.asin_k, math.asin_kl, 0.0, math.poly_asin(0.0));
probe(math.sin_k, math.sin_kl, 0.0, math.poly_sin(0.0));
probe(math.cos_k, math.cos_kl, 0.0, math.poly_cos(0.0));

print(asked);
print(bad);